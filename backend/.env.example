PORT=4000
DATABASE_URL=postgres://utilisateur:motdepasse@localhost:5432/gestion_locative
JWT_SECRET=change_moi_avant_la_mise_en_ligne

# Adresse de l'application frontend (utilisée dans le lien envoyé par email
# pour vérifier son adresse). En local, laisser tel quel ; en production,
# mettre l'adresse réelle du site une fois déployé.
FRONTEND_URL=http://localhost:5173

# Envoi d'emails (vérification d'adresse, mot de passe oublié) via un compte
# Gmail. Tant que ces deux lignes sont vides/absentes, aucun email n'est
# réellement envoyé (juste écrit dans les logs du serveur) — pratique pour
# développer sans compte Gmail.
#
# Pour les activer :
# 1. Utiliser un compte Gmail (le tien ou un compte dédié à l'appli).
# 2. Activer la validation en 2 étapes sur ce compte Google (obligatoire
#    pour l'étape suivante) : myaccount.google.com/security
# 3. Créer un "mot de passe d'application" : myaccount.google.com/apppasswords
#    (choisir "Autre", donner un nom comme "Gestion Locative") — Google
#    donne un mot de passe de 16 caractères, différent du mot de passe
#    normal du compte.
# 4. Mettre l'email Gmail et ce mot de passe de 16 caractères ci-dessous
#    (sans espaces).
GMAIL_UTILISATEUR=
GMAIL_MOT_DE_PASSE_APPLICATION=
