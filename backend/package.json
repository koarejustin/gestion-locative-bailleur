{
  "name": "gestion-locative-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend de l'application de gestion locative (bailleur, biens, locataires, paiements)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:create": "node database/create-db.js",
    "migrate": "node database/run-migrations.js",
    "setup": "npm run db:create && npm run migrate",
    "reset-donnees": "node database/reset-donnees.js",
    "reset-donnees:confirmer": "node database/reset-donnees.js --confirmer"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "nodemailer": "^6.9.14",
    "pdfkit": "^0.20.2",
    "pg": "^8.11.5"
  }
}
